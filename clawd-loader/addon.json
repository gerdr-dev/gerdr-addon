{
  "name": "Pixel Clawd",
  "version": "1.0.0",
  "description": "Replaces the working dots with a pixel Clawd that walks and plays with its prop while a turn runs, and waves when it waits on you. Seven costumes.",
  "icon": "icon.svg",
  "screenshots": ["screenshot.png", "costumes.png"],
  "settings": [
    {
      "key": "costume",
      "title": "Costume",
      "type": "select",
      "default": "clawd",
      "options": [
        { "value": "clawd", "label": "Classic" },
        { "value": "explore", "label": "Pirate" },
        { "value": "heavy", "label": "Detective" },
        { "value": "careful", "label": "Engineer" },
        { "value": "medium", "label": "Chef" },
        { "value": "light", "label": "Racer" },
        { "value": "fable", "label": "Astronaut" }
      ]
    },
    {
      "key": "size",
      "title": "Size",
      "type": "select",
      "default": "small",
      "options": [
        { "value": "small", "label": "Small (18×12)" },
        { "value": "medium", "label": "Medium (24×16, crisper)" }
      ]
    }
  ],
  "i18n": {
    "zh": {
      "name": "像素 Clawd",
      "description": "把对话运行中那个 9 个点的 loading 换成像素小螃蟹 Clawd：跑的时候走路、摆弄道具，等你确认时停下来挥爪子。7 个造型可选。",
      "settings": {
        "costume": {
          "title": "造型",
          "options": {
            "clawd": "原版 Clawd",
            "explore": "海盗 · 挥刀",
            "heavy": "侦探 · 放大镜",
            "careful": "工程师 · 拧扳手",
            "medium": "厨师 · 颠锅",
            "light": "赛车手 · 快跑摇旗",
            "fable": "宇航员 · 漂浮"
          }
        },
        "size": {
          "title": "尺寸",
          "options": { "small": "小（18×12）", "medium": "中（24×16，像素更清楚）" }
        }
      }
    }
  }
}
