{
  "name": "MiMo 朗读",
  "version": "1.1.1",
  "description": "用小米 MiMo 的语音合成朗读消息：点消息旁边的喇叭，读你说的话或 agent 的回复。长回复一段一段合成，第一句很快就开始读。",
  "icon": "icon.svg",
  "screenshots": [],
  "settings": [
    {
      "key": "apiKey",
      "title": "API Key",
      "type": "secret",
      "default": "",
      "description": "在 platform.xiaomimimo.com 申请。"
    },
    {
      "key": "voice",
      "title": "音色",
      "type": "select",
      "default": "茉莉",
      "options": [
        {
          "value": "茉莉",
          "label": "茉莉（女声，知性）"
        },
        {
          "value": "冰糖",
          "label": "冰糖"
        },
        {
          "value": "苏打",
          "label": "苏打"
        },
        {
          "value": "白桦",
          "label": "白桦"
        },
        {
          "value": "mimo_default",
          "label": "默认（mimo_default）"
        },
        {
          "value": "default_zh",
          "label": "中文（default_zh）"
        },
        {
          "value": "default_en",
          "label": "英文（default_en）"
        },
        {
          "value": "Mia",
          "label": "Mia"
        },
        {
          "value": "Chloe",
          "label": "Chloe"
        },
        {
          "value": "Milo",
          "label": "Milo"
        },
        {
          "value": "Dean",
          "label": "Dean"
        }
      ]
    },
    {
      "key": "style",
      "title": "朗读风格",
      "type": "string",
      "default": "自然、亲切、利落，不要播音腔，语速中等偏快",
      "description": "一句话说想要的语气，随文字一起发给模型。清空就是模型默认的读法。"
    },
    {
      "key": "preview",
      "title": "试听",
      "type": "action",
      "label": "播放",
      "description": "用上面的音色和风格读一句，听听配置对不对。"
    },
    {
      "key": "model",
      "title": "模型",
      "type": "select",
      "default": "mimo-v2.5-tts",
      "options": [
        {
          "value": "mimo-v2.5-tts",
          "label": "mimo-v2.5-tts"
        },
        {
          "value": "mimo-v2-tts",
          "label": "mimo-v2-tts"
        }
      ]
    },
    {
      "key": "baseURL",
      "title": "接口地址",
      "type": "string",
      "default": "https://api.xiaomimimo.com/v1",
      "description": "走代理 / 中转时改这里。"
    }
  ],
  "i18n": {
    "en": {
      "name": "MiMo Read Aloud",
      "description": "Reads messages aloud with Xiaomi MiMo's speech synthesis: tap the speaker beside a message. Long replies are synthesized piece by piece, so reading starts right away.",
      "settings": {
        "apiKey": {
          "description": "From platform.xiaomimimo.com."
        },
        "voice": {
          "title": "Voice"
        },
        "style": {
          "title": "Style",
          "description": "The tone you want, in a sentence, sent to the model with the text. Empty: the model's own reading."
        },
        "model": {
          "title": "Model"
        },
        "baseURL": {
          "title": "API address",
          "description": "Change it to go through a proxy."
        },
        "preview": {
          "title": "Preview",
          "label": "Play",
          "description": "Reads a sentence with the voice and style above, to check the settings work."
        }
      }
    }
  }
}
